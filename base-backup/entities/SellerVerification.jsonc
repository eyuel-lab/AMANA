{
  "name": "SellerVerification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "legal_name": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "id_document_uri": {
      "type": "string"
    },
    "business_document_uri": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "more_info",
        "verified",
        "rejected",
        "suspended"
      ],
      "default": "pending"
    },
    "review_notes": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string"
    },
    "decided_at": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "reviewer"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "reviewer"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}