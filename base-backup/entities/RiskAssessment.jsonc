{
  "name": "RiskAssessment",
  "type": "object",
  "properties": {
    "subject_type": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "subject_label": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "score": {
      "type": "number"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "explanation": {
      "type": "string"
    },
    "review_state": {
      "type": "string",
      "enum": [
        "auto",
        "pending_review",
        "reviewed"
      ],
      "default": "auto"
    },
    "reviewer_outcome": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "reviewer"
          }
        },
        {
          "user_condition": {
            "role": "investigator"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}