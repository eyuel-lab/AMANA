{
  "name": "TheftOrLossReport",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string"
    },
    "record_ref": {
      "type": "string"
    },
    "item_label": {
      "type": "string"
    },
    "reporter_id": {
      "type": "string"
    },
    "reporter_name": {
      "type": "string"
    },
    "report_number": {
      "type": "string"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "lost",
        "stolen"
      ]
    },
    "description": {
      "type": "string"
    },
    "evidence_uris": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "more_info",
        "confirmed",
        "rejected",
        "resolved",
        "closed"
      ],
      "default": "submitted"
    },
    "decision_notes": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "restriction_active": {
      "type": "boolean",
      "default": true
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.reporter_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "reviewer"
          }
        },
        {
          "user_condition": {
            "role": "investigator"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}