{
  "name": "InvestigationCase",
  "type": "object",
  "properties": {
    "case_number": {
      "type": "string"
    },
    "report_id": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "record_ref": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "assigned_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_review",
        "awaiting_info",
        "closed"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "string"
    },
    "opened_at": {
      "type": "string"
    },
    "closed_at": {
      "type": "string"
    },
    "opened_by": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.assigned_to": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "investigator"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}