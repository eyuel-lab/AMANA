{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "is_security": {
      "type": "boolean",
      "default": false
    }
  },
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}
