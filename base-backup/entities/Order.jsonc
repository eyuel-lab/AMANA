{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_email": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "subtotal": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "ETB"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "paid",
        "confirmed",
        "processing",
        "ready",
        "completed",
        "cancelled",
        "refund_pending",
        "refunded",
        "disputed"
      ],
      "default": "pending_payment"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "pending",
        "paid",
        "refunded"
      ],
      "default": "unpaid"
    },
    "payment_provider": {
      "type": "string",
      "default": "unconfigured"
    },
    "payment_reference": {
      "type": "string"
    },
    "delivery_name": {
      "type": "string"
    },
    "delivery_phone": {
      "type": "string"
    },
    "delivery_city": {
      "type": "string"
    },
    "delivery_notes": {
      "type": "string"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "paid_at": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "investigator"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}