{
  "name": "Dispute",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "opened_by_id": {
      "type": "string"
    },
    "opened_by_name": {
      "type": "string"
    },
    "party_role": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "under_review",
        "resolved",
        "rejected"
      ],
      "default": "open"
    },
    "assigned_to": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.opened_by_id": "{{user.id}}"
        },
        {
          "data.assigned_to": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "reviewer"
          }
        },
        {
          "user_condition": {
            "role": "investigator"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}