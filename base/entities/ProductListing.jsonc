{
  "name": "ProductListing",
  "type": "object",
  "properties": {
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "seller_verified": {
      "type": "boolean",
      "default": false
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "like_new",
        "good",
        "fair"
      ]
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "ETB"
    },
    "location": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "specifications": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "active",
        "paused",
        "rejected",
        "sold",
        "reserved"
      ],
      "default": "draft"
    },
    "moderation_notes": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "registry_record_id": {
      "type": "string"
    },
    "registry_status": {
      "type": "string"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "submitted_at": {
      "type": "string"
    },
    "published_at": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "active"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "reviewer"
          }
        },
        {
          "user_condition": {
            "role": "investigator"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.status": {
            "$in": [
              "draft"
            ]
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.status": {
            "$in": [
              "draft",
              "paused",
              "rejected"
            ]
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.status": {
            "$in": [
              "draft",
              "rejected"
            ]
          }
        }
      ]
    }
  }
}